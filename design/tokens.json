{
  "version": "0.2.0",
  "product": "个人用药助手",
  "font": {
    "family": "sans-serif",
    "androidFallback": "sans-serif",
    "figmaPreferred": "Inter"
  },
  "primitives": {
    "ink/950": "#142522",
    "ink/700": "#31504A",
    "ink/500": "#657A73",
    "paper/50": "#F7F8F4",
    "paper/100": "#EEF2EB",
    "paper/0": "#FFFFFF",
    "teal/700": "#0F665D",
    "teal/600": "#147A6D",
    "teal/100": "#D6EFE8",
    "amber/700": "#8A5200",
    "amber/100": "#FFF0C7",
    "red/700": "#A33C3C",
    "red/100": "#FCE3E1",
    "blue/700": "#315EA8",
    "blue/100": "#DEE9FF"
  },
  "semantic": {
    "light": {
      "color/bg/app": "paper/50",
      "color/bg/surface": "paper/0",
      "color/bg/soft": "paper/100",
      "color/text/primary": "ink/950",
      "color/text/secondary": "ink/500",
      "color/brand/primary": "teal/700",
      "color/brand/soft": "teal/100",
      "color/status/warning": "amber/700",
      "color/status/warningSoft": "amber/100",
      "color/status/danger": "red/700",
      "color/status/dangerSoft": "red/100",
      "color/status/info": "blue/700",
      "color/status/infoSoft": "blue/100",
      "color/border/default": "#D7E1DB"
    },
    "dark": {
      "color/bg/app": "#10201D",
      "color/bg/surface": "#172A26",
      "color/bg/soft": "#203A34",
      "color/text/primary": "#F3F8F3",
      "color/text/secondary": "#B1C6BC",
      "color/brand/primary": "#78D5C4",
      "color/brand/soft": "#245148",
      "color/status/warning": "#FFD37B",
      "color/status/warningSoft": "#5A4216",
      "color/status/danger": "#FFB4AB",
      "color/status/dangerSoft": "#5A2526",
      "color/status/info": "#B6C9FF",
      "color/status/infoSoft": "#283B6C",
      "color/border/default": "#36534B"
    }
  },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "2xl": 32, "3xl": 48 },
  "radius": { "sm": 10, "md": 16, "lg": 24, "full": 999 },
  "type": {
    "display": { "size": 32, "lineHeight": 40, "weight": 700 },
    "title": { "size": 24, "lineHeight": 32, "weight": 700 },
    "body": { "size": 16, "lineHeight": 24, "weight": 400 },
    "label": { "size": 14, "lineHeight": 20, "weight": 600 },
    "caption": { "size": 12, "lineHeight": 16, "weight": 500 }
  },
  "elevation": {
    "subtle": { "y": 1, "blur": 3, "opacity": 0.06 },
    "card": { "y": 4, "blur": 14, "opacity": 0.08 }
  },
  "motion": {
    "pressMs": 140,
    "contentMs": 220,
    "listStaggerMs": 28,
    "maxStaggerDelayMs": 140,
    "decorativeAnimationDisabledWhenAnimatorScaleZero": true
  },
  "accessibility": { "minTouchTargetDp": 48, "defaultLockscreenNotification": "private" }
}
