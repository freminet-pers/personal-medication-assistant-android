<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" app:cardCornerRadius="18dp" app:cardElevation="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/occurrence_time" android:layout_width="64dp" android:layout_height="wrap_content" android:textColor="@color/luna_teal_700" android:textSize="20sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/occurrence_medication" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/luna_ink_950" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/occurrence_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/luna_ink_500" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/occurrence_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/occurrence_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="end" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/occurrence_taken" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已服用" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/occurrence_skip" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="跳过" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/occurrence_snooze" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="稍后" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/occurrence_undo" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="撤销" android:textAllCaps="false" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
